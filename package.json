{
  "name": "project-quality-release-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Config-driven multi-project quality, regression and release validation",
  "scripts": {
    "test": "node --test browser/tests/*.test.mjs",
